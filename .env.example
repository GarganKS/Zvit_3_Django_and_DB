# Скопіюйте файл у .env і підставте свої значення.
# Читається python-dotenv (project_BusFlow/settings.py) і docker compose.
# Значення з оточення мають пріоритет над файлом.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
# Хости для Django (порожньо = за замовчуванням з DEBUG)
# ALLOWED_HOSTS=127.0.0.1,localhost

# --- MySQL ---
DB_NAME=busflow
DB_USER=busflow
DB_PASSWORD=change-me-to-a-strong-password
DB_HOST=127.0.0.1
DB_PORT=3307
# Пароль root'а MySQL - тільки для адміністрування (дамп, міграції)
MYSQL_ROOT_PASSWORD=change-me-to-another-strong-password
